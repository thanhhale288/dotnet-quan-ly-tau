<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <!--
    Đổi Data Source nếu SQL Server không phải instance mặc định.
    SQL Express: Data Source=.\SQLEXPRESS
    LocalDB:     Data Source=(localdb)\MSSQLLocalDB
  -->
  <connectionStrings>
    <add name="QuanLyTau"
         connectionString="Data Source=.;Initial Catalog=QuanLyTau;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
