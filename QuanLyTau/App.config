<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <!--
    File này là nguồn đúng để sửa chuỗi kết nối.
    Trong XML chỉ cần MỘT dấu \ : .\SQLEXPRESS
    (Trong file .cs mới cần \\ hoặc @"...").

    Sau khi sửa: Build → Rebuild Solution, rồi F5 lại.
    Kiểm tra file copy: QuanLyTau\bin\Debug\QuanLyTau.exe.config

    Các Data Source thường gặp:
      .\SQLEXPRESS
      .
      (localdb)\MSSQLLocalDB
      localhost\SQLEXPRESS
  -->
  <connectionStrings>
    <add name="QuanLyTau"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=QuanLyTau;Integrated Security=True;TrustServerCertificate=True;Connect Timeout=15"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
